# Omnistrata shared Ollama runtime (same instance as CoverIQ/Syntrix — do NOT run a second Ollama for ForgEd)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_API_KEY=
OLLAMA_TEMPERATURE=0.5
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=768
OLLAMA_HTTP_TIMEOUT_SECONDS=900

# Set true if you run llama3.1:8b and do not want auto-remap to llama3.2:1b
SYNTRIX_DISABLE_OLLAMA_MODEL_AUTO_CORRECT=false

# KODA — production uses Syntrix /api/forged/koda → same Hetzner Ollama as MIRA (CoverIQ)
KODA_ENABLED=true
SYNTRIX_API_URL=https://api.syntrix.solutions
# Must match Render Syntrix scanner + ForgEd Netlify (same value as FORGED_SETUP.SERVER_SECRET)
FORGED_SERVER_SECRET=your-shared-secret-matching-script-property-FORGED_SERVER_SECRET

# Optional local dev: direct Ollama (skip Syntrix bridge)
# KODA_USE_SYNTRIX_FORGED=false
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_API_KEY=

# Syntrix auth (same Omnistrata accounts as CoverIQ MIRA)
SYNTRIX_API_URL=https://api.syntrix.solutions
# Optional: browser calls Syntrix directly in dev (otherwise uses /api/syntrix/* proxy)
# NEXT_PUBLIC_SYNTRIX_API_URL=

# ForgEd accounts + progress (Google Apps Script — google-apps-script/forged-accounts/)
FORGED_WEB_APP_URL=https://script.google.com/macros/s/AKfycbyMUFkHPuSN2ajb-09lXAZvxt1n7M59dZ4L2NlpLTy8H3l3Ay_Nyx3iIP19XhwA7x-Q/exec
FORGED_SERVER_SECRET=your-shared-secret-matching-script-property-FORGED_SERVER_SECRET

# KODA: when FORGED_WEB_APP_URL is set, sign-in uses ForgEd session + OLLAMA_BASE_URL
# Legacy Syntrix-only deploys: KODA_USE_SYNTRIX=true and SYNTRIX_API_URL
