# Omnistrata shared Ollama runtime (same instance as CoverIQ/Syntrix — do NOT run a second Ollama for ForgEd)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_API_KEY=
OLLAMA_TEMPERATURE=0.5
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=768
OLLAMA_HTTP_TIMEOUT_SECONDS=900

# Set true if you run llama3.1:8b and do not want auto-remap to llama3.2:1b
SYNTRIX_DISABLE_OLLAMA_MODEL_AUTO_CORRECT=false

# KODA (ForgEd educational assistant — powered by shared Ollama, not a separate model)
KODA_ENABLED=true

# Optional: future memory service (Redis/Qdrant) — placeholders only for now
# KODA_MEMORY_ENABLED=false
# KODA_REDIS_URL=
# KODA_QDRANT_URL=
